{
  "description": "Global agent Git safety policy.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/libexec/agent-guards/block-remote-main-push.py\"",
            "timeout": 5,
            "statusMessage": "Checking remote-main push policy"
          }
        ]
      }
    ]
  }
}

